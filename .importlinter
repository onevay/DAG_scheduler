[importlinter]
root_package = expsched

# Пакет может импортировать только пакеты из слоёв ниже; пакеты одного слоя друг друга не импортируют.
# Слои в скобках пока не созданы.
[importlinter:contract:layers]
name = Слои ядра
type = layers
layers =
    (expsched.api) | (expsched.cli) | (expsched.io)
    (expsched.explain) | (expsched.metrics)
    expsched.engine | (expsched.policies)
    expsched.validation
    expsched.analysis | expsched.contract
    expsched.domain
