[importlinter]
root_package = expsched

# Пакет может импортировать только пакеты из слоёв ниже; пакеты одного слоя друг друга не импортируют.
# Слои в скобках пока не созданы.
[importlinter:contract:layers]
name = Слои ядра
type = layers
layers =
    expsched.api | expsched.agent | (expsched.cli) | (expsched.io)
    expsched.pipeline
    expsched.explain | expsched.metrics
    expsched.verify
    expsched.engine | expsched.policies
    expsched.validation
    expsched.analysis | expsched.contract
    expsched.domain

# Проверка расписания не должна доверять коду, который она проверяет.
[importlinter:contract:verify-independent]
name = Проверка не зависит от движка и политик
type = forbidden
source_modules = expsched.verify
forbidden_modules =
    expsched.engine
    expsched.policies

# Агент работает на другой машине и знает только протокол: ни движка, ни политик, ни API планировщика.
[importlinter:contract:agent-knows-only-the-contract]
name = Агент зависит только от контракта
type = forbidden
source_modules = expsched.agent
forbidden_modules =
    expsched.api
    expsched.pipeline
    expsched.explain
    expsched.metrics
    expsched.verify
    expsched.engine
    expsched.policies
    expsched.validation
    expsched.analysis
